(executable
 (name yaml_fuzz)
 (modules yaml_fuzz)
 (modes native)
 (libraries wv_foundation wv_syntax))

(executable
 (name yaml_conformance)
 (modules yaml_conformance)
 (libraries wv_foundation wv_syntax))

(rule
 (alias mutation-yaml-conformance)
 (deps
  yaml_conformance.exe
  (env_var WORKFLOW_VERIFIER_YAML_SUITE))
 (action
  (run
   %{exe:yaml_conformance.exe}
   --suite
   %{env:WORKFLOW_VERIFIER_YAML_SUITE=})))

