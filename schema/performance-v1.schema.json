{
  "$id": "https://workflow-verifier.dev/schema/performance-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "samples_ns": {
          "items": { "minimum": 1, "type": "integer" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["samples_ns"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "environment": {
      "additionalProperties": { "minLength": 1, "type": "string" },
      "minProperties": 1,
      "type": "object"
    },
    "regression_explanations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mode": { "enum": ["cold", "incremental", "warm"] },
          "reason": { "minLength": 20, "type": "string" },
          "review": { "pattern": "^https://", "type": "string" },
          "scenario": { "type": "string" }
        },
        "required": ["scenario", "mode", "reason", "review"],
        "type": "object"
      },
      "type": "array"
    },
    "revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string" },
          "modes": {
            "additionalProperties": false,
            "properties": {
              "cold": { "$ref": "#/$defs/measurement" },
              "incremental": { "$ref": "#/$defs/measurement" },
              "warm": { "$ref": "#/$defs/measurement" }
            },
            "required": ["cold", "incremental", "warm"],
            "type": "object"
          }
        },
        "required": ["id", "modes"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": { "const": "performance-v1" }
  },
  "required": ["schema", "revision", "environment", "scenarios", "regression_explanations"],
  "title": "workflow-verifier performance ledger v1",
  "type": "object"
}
