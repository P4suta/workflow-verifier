{
  "$id": "https://workflow-verifier.dev/schema/workflow-verifier-report-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "position": { "additionalProperties": false, "properties": { "byte": { "minimum": 0, "type": "integer" }, "column": { "minimum": 1, "type": "integer" }, "line": { "minimum": 1, "type": "integer" } }, "required": ["byte", "column", "line"], "type": "object" },
    "span": { "additionalProperties": false, "properties": { "source": { "minimum": 0, "type": "integer" }, "start": { "$ref": "#/$defs/position" }, "stop": { "$ref": "#/$defs/position" } }, "required": ["source", "start", "stop"], "type": "object" },
    "diagnostic": { "additionalProperties": false, "properties": { "capabilities": { "items": { "type": "string" }, "minItems": 1, "type": "array", "uniqueItems": true }, "confidence": { "enum": ["high", "medium", "low"] }, "evidence": { "items": { "type": "string" }, "minItems": 1, "type": "array" }, "fix": { "additionalProperties": false, "properties": { "description": { "type": "string" }, "kind": { "type": "string" }, "replacement": { "type": "string" }, "span": { "$ref": "#/$defs/span" } }, "required": ["description", "kind"], "type": "object" }, "id": { "pattern": "^diag_[0-9a-f]{64}$", "type": "string" }, "message": { "minLength": 1, "type": "string" }, "rule_id": { "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$", "type": "string" }, "severity": { "enum": ["critical", "error", "warning", "note"] }, "span": { "$ref": "#/$defs/span" }, "trace": { "items": { "additionalProperties": false, "properties": { "label": { "type": "string" }, "node": { "minimum": 0, "type": "integer" }, "span": { "$ref": "#/$defs/span" } }, "required": ["label", "node", "span"], "type": "object" }, "minItems": 1, "type": "array" } }, "required": ["confidence", "id", "message", "rule_id", "severity", "span"], "type": "object" },
    "property": { "additionalProperties": false, "properties": { "explanation": { "type": "string" }, "id": { "type": "string" }, "reasons": { "items": { "type": "object" }, "minItems": 1, "type": "array" }, "state": { "enum": ["Proved", "Violated", "Unknown", "NotApplicable"] }, "subject": { "type": "string" } }, "required": ["explanation", "id", "state"], "type": "object" }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_digest": { "$ref": "#/$defs/digest" },
    "completeness": { "additionalProperties": false, "properties": { "reasons": { "items": { "pattern": "^Incomplete\\.", "type": "string" }, "type": "array", "uniqueItems": true }, "state": { "enum": ["complete", "incomplete"] } }, "required": ["reasons", "state"], "type": "object" },
    "diagnostics": { "items": { "$ref": "#/$defs/diagnostic" }, "type": "array" },
    "digest": { "$ref": "#/$defs/digest" },
    "gate": { "additionalProperties": false, "properties": { "exit_code": { "enum": [0, 1, 3] }, "result": { "enum": ["pass", "finding", "incomplete"] } }, "required": ["exit_code", "result"], "type": "object" },
    "inputs": { "additionalProperties": false, "properties": { "config": { "additionalProperties": false, "properties": { "digest": { "$ref": "#/$defs/digest" }, "origin": { "minLength": 1, "not": { "pattern": "(^/|^[A-Za-z]:)" }, "type": "string" }, "trust": { "enum": ["built-in", "trusted-policy", "repository"] } }, "required": ["digest", "origin", "trust"], "type": "object" }, "lock": { "additionalProperties": false, "properties": { "digest": { "$ref": "#/$defs/digest" } }, "required": ["digest"], "type": "object" }, "manifest_digest": { "$ref": "#/$defs/digest" }, "sources": { "items": { "additionalProperties": false, "properties": { "digest": { "$ref": "#/$defs/digest" }, "id": { "minimum": 0, "type": "integer" }, "path": { "minLength": 1, "not": { "pattern": "(^/|^[A-Za-z]:)" }, "type": "string" } }, "required": ["digest", "id", "path"], "type": "object" }, "type": "array" } }, "required": ["config", "lock", "manifest_digest", "sources"], "type": "object" },
    "persona": { "enum": ["gate", "audit", "paranoid"] },
    "properties": { "items": { "$ref": "#/$defs/property" }, "type": "array" },
    "providers": { "items": { "minLength": 1, "type": "string" }, "type": "array", "uniqueItems": true },
    "schema": { "const": "workflow-verifier-report/1" },
    "summary": { "additionalProperties": false, "properties": { "diagnostics": { "minimum": 0, "type": "integer" }, "edges": { "minimum": 0, "type": "integer" }, "nodes": { "minimum": 0, "type": "integer" }, "properties": { "minimum": 0, "type": "integer" }, "sources": { "minimum": 0, "type": "integer" }, "unknown_properties": { "minimum": 0, "type": "integer" }, "violated_properties": { "minimum": 0, "type": "integer" } }, "required": ["diagnostics", "edges", "nodes", "properties", "sources", "unknown_properties", "violated_properties"], "type": "object" },
    "tool": { "additionalProperties": false, "properties": { "commit": { "type": ["string", "null"] }, "compiler": { "minLength": 1, "type": "string" }, "name": { "const": "workflow-verifier" }, "target": { "minLength": 1, "type": "string" }, "version": { "type": "string" } }, "required": ["commit", "compiler", "name", "target", "version"], "type": "object" }
  },
  "required": ["analysis_digest", "completeness", "diagnostics", "digest", "gate", "inputs", "persona", "properties", "providers", "schema", "summary", "tool"],
  "title": "workflow-verifier check report 1",
  "type": "object"
}
