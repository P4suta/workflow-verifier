{
  "$id": "https://workflow-verifier.dev/schema/release-gate-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "finding": {
      "additionalProperties": false,
      "properties": {
        "classification": { "minLength": 1, "not": { "pattern": "^[Uu]nclassified$" }, "type": "string" },
        "id": { "minLength": 1, "type": "string" },
        "resolution": { "minLength": 1, "type": "string" },
        "severity": { "enum": ["medium", "low", "info"] }
      },
      "required": ["classification", "id", "resolution", "severity"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "details": { "type": "object" },
    "findings": { "items": { "$ref": "#/$defs/finding" }, "type": "array" },
    "gate": { "pattern": "^[a-z0-9][a-z0-9-]*$", "type": "string" },
    "schema": { "const": "release-gate-v1" },
    "status": { "const": "pass" },
    "subject_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
  },
  "required": ["findings", "gate", "schema", "status", "subject_commit"],
  "title": "workflow-verifier release gate result v1",
  "type": "object"
}
