{
  "$id": "https://workflow-verifier.dev/schema/config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "provider": { "enum": ["github", "gitlab", "azure", "circleci"] } },
          "required": ["provider"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "kind": { "enum": ["trigger", "parameter", "workflow", "stage", "job", "step", "call", "command", "gate", "resource", "effect", "opaque"] } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "path": { "minLength": 1, "type": "string" } },
          "required": ["path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "trust": { "enum": ["trusted", "untrusted", "mixed", "unknown"] } },
          "required": ["trust"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "effect": { "enum": ["repository_change", "network_request", "file_read", "file_write", "command_execution", "artifact_publish", "cache_publish", "deployment_change", "credential_use", "workflow_change", "ai_agent_execution"] } },
          "required": ["effect"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "capability": { "enum": ["repository_read", "repository_write", "token_read", "token_write", "oidc", "cloud_credential", "secret_access", "network", "filesystem_read", "filesystem_write", "shell", "artifact_read", "artifact_write", "cache_read", "cache_write", "deployment", "self_hosted_persistence", "ai_tool"] } },
          "required": ["capability"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "mutability": { "enum": ["immutable", "mutable", "local", "unknown"] } },
          "required": ["mutability"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "dominated_by_gate": { "type": "boolean" } },
          "required": ["dominated_by_gate"],
          "type": "object"
        }
      ]
    },
    "selector": {
      "additionalProperties": false,
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "all": { "items": { "$ref": "#/$defs/predicate" }, "type": "array" },
        "any": { "items": { "$ref": "#/$defs/predicate" }, "type": "array" },
        "none": { "items": { "$ref": "#/$defs/predicate" }, "type": "array" }
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowlist": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["dependency", "network_host", "source"] },
          "reason": { "minLength": 1, "type": "string" },
          "value": { "minLength": 1, "type": "string" }
        },
        "required": ["kind", "value", "reason"],
        "type": "object"
      },
      "type": "array"
    },
    "frontends": {
      "items": { "enum": ["github", "gitlab", "azure", "circleci"] },
      "type": "array",
      "uniqueItems": true
    },
    "offline": { "const": true },
    "persona": { "enum": ["gate", "audit", "paranoid"] },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": { "pattern": "^[A-Za-z0-9_.-]+$", "type": "string" },
          "kind": { "enum": ["forbid", "require", "limit", "forbid_path"] },
          "limit": { "minimum": 0, "type": ["integer", "null"] },
          "message": { "minLength": 1, "type": "string" },
          "selector": { "$ref": "#/$defs/selector" },
          "severity": { "enum": ["critical", "error", "warning", "note"] }
        },
        "required": ["id", "kind", "message", "severity", "selector"],
        "type": "object"
      },
      "type": "array"
    },
    "resolver": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": { "items": { "type": "string" }, "type": "array", "uniqueItems": true },
        "require_immutable": { "const": true }
      },
      "required": ["require_immutable", "allowed_sources"],
      "type": "object"
    },
    "sandbox": {
      "additionalProperties": false,
      "properties": {
        "backend": { "pattern": "^(oci:[A-Za-z0-9_.-]+|linux-native|windows-native|macos-vm)$", "type": "string" },
        "cpu_seconds": { "minimum": 1, "type": "integer" },
        "image": { "pattern": "^sha256:([0-9a-f]{64}|unresolved)$", "type": "string" },
        "memory_mb": { "minimum": 1, "type": "integer" },
        "network": { "const": "deny" },
        "output_bytes": { "minimum": 1, "type": "integer" },
        "processes": { "minimum": 1, "type": "integer" }
      },
      "required": ["backend", "image", "network", "cpu_seconds", "memory_mb", "processes", "output_bytes"],
      "type": "object"
    },
    "suppressions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": { "type": ["string", "null"] },
          "reason": { "minLength": 1, "type": "string" },
          "rule": { "type": "string" }
        },
        "required": ["rule", "path", "reason"],
        "type": "object"
      },
      "type": "array"
    },
    "version": { "const": 1 }
  },
  "required": ["version", "persona", "frontends", "offline", "resolver", "sandbox", "allowlist", "rules", "suppressions"],
  "title": "workflow-verifier normalized configuration v1",
  "type": "object"
}
