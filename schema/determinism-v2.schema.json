{
  "$id": "https://workflow-verifier.dev/schema/determinism-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
        "name": { "enum": ["fix.diff", "report-v3.json", "workflow-verifier.lock"] },
        "size": { "minimum": 1, "type": "integer" }
      },
      "required": ["digest", "name", "size"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": { "$ref": "#/$defs/artifact" },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "local_repetitions": { "const": 2 },
    "report_semantic_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "schema": { "const": "determinism-v2" }
  },
  "required": ["artifacts", "local_repetitions", "report_semantic_digest", "schema"],
  "title": "workflow-verifier cross-platform determinism probe v2",
  "type": "object"
}
