{
  "$id": "https://workflow-verifier.dev/schema/crate-package-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
        "name": { "pattern": "^workflow-verifier-[0-9A-Za-z.+-]+\\.crate$", "type": "string" },
        "role": { "const": "crate-package" },
        "size": { "minimum": 1, "type": "integer" }
      },
      "required": ["digest", "name", "role", "size"],
      "type": "object"
    },
    "file_count": { "minimum": 1, "type": "integer" },
    "schema": { "const": "crate-package-v1" },
    "subject_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": ["artifact", "file_count", "schema", "subject_commit", "version"],
  "title": "workflow-verifier reproducible crates.io package evidence v1",
  "type": "object"
}
