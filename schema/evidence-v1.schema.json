{
  "$defs": {
    "body": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "controls_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
            "id": { "minLength": 1, "type": "string" },
            "kind": { "const": "backend_attested" },
            "platform": { "minLength": 1, "type": "string" },
            "version": { "minLength": 1, "type": "string" }
          },
          "required": ["controls_digest", "id", "kind", "platform", "version"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "control": { "minLength": 1, "type": "string" }, "kind": { "const": "control_attested" } },
          "required": ["control", "kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "argv": { "items": { "type": "string" }, "type": "array" },
            "executable": { "minLength": 1, "type": "string" },
            "kind": { "const": "process_started" }
          },
          "required": ["argv", "executable", "kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "code": { "type": "integer" }, "kind": { "const": "process_exited" } },
          "required": ["code", "kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "boolean" },
            "kind": { "const": "filesystem_access" },
            "operation": { "minLength": 1, "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["allowed", "kind", "operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "boolean" },
            "host": { "minLength": 1, "type": "string" },
            "kind": { "const": "network_attempt" },
            "port": { "maximum": 65535, "minimum": 0, "type": "integer" }
          },
          "required": ["allowed", "host", "kind", "port"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
            "kind": { "const": "artifact_recorded" },
            "path": { "minLength": 1, "type": "string" }
          },
          "required": ["digest", "kind", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "secret_redacted" }, "name": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string" } },
          "required": ["kind", "name"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "backend_error" }, "message": { "minLength": 1, "type": "string" } },
          "required": ["kind", "message"],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://workflow-verifier.dev/schema/evidence-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": { "$ref": "#/$defs/body" },
          "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
          "previous_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
          "sequence": { "minimum": 0, "type": "integer" }
        },
        "required": ["body", "digest", "previous_digest", "sequence"],
        "type": "object"
      },
      "type": "array"
    },
    "plan_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "schema": { "const": "evidence-v1" }
  },
  "required": ["events", "plan_digest", "schema"],
  "title": "workflow-verifier runtime evidence v1",
  "type": "object"
}
