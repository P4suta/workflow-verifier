{
  "$id": "https://workflow-verifier.dev/schema/release-evidence-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fileEvidence": {
      "additionalProperties": false,
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "path": {
          "minLength": 1,
          "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)|\\\\" },
          "type": "string"
        },
        "review": {
          "format": "uri",
          "pattern": "^https://github\\.com/P4suta/workflow-verifier/(?:issues|pull)/[1-9][0-9]*(?:#.*)?$",
          "type": "string"
        }
      },
      "required": ["digest", "path", "review"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus": { "$ref": "#/$defs/fileEvidence" },
    "performance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": { "$ref": "#/$defs/digest" },
          "path": {
            "minLength": 1,
            "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)|\\\\" },
            "type": "string"
          },
          "platform": {
            "enum": ["linux-x86_64", "windows-x86_64", "macos-arm64", "macos-x86_64"]
          },
          "review": {
            "format": "uri",
            "pattern": "^https://github\\.com/P4suta/workflow-verifier/(?:issues|pull)/[1-9][0-9]*(?:#.*)?$",
            "type": "string"
          }
        },
        "required": ["digest", "path", "platform", "review"],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "schema": { "const": "release-evidence-v1" },
    "security_review": {
      "additionalProperties": false,
      "properties": {
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "bundle_path": {
          "minLength": 1,
          "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)|\\\\" },
          "pattern": "\\.sigstore\\.json$",
          "type": "string"
        },
        "certificate_identity": {
          "format": "uri",
          "not": { "pattern": "^https://github\\.com/P4suta/workflow-verifier/" },
          "pattern": "^https://github\\.com/[^/]+/[^/]+/\\.github/workflows/[^@]+@refs/tags/[^ ]+$",
          "type": "string"
        },
        "certificate_oidc_issuer": { "const": "https://token.actions.githubusercontent.com" },
        "decision": { "const": "approved" },
        "independence": { "minLength": 32, "type": "string" },
        "report_digest": { "$ref": "#/$defs/digest" },
        "report_path": {
          "minLength": 1,
          "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)|\\\\" },
          "pattern": "\\.pdf$",
          "type": "string"
        },
        "review": {
          "format": "uri",
          "pattern": "^https://github\\.com/P4suta/workflow-verifier/(?:issues|pull)/[1-9][0-9]*(?:#.*)?$",
          "type": "string"
        },
        "reviewer": { "minLength": 3, "type": "string" }
      },
      "required": [
        "bundle_digest",
        "bundle_path",
        "certificate_identity",
        "certificate_oidc_issuer",
        "decision",
        "independence",
        "report_digest",
        "report_path",
        "review",
        "reviewer"
      ],
      "type": "object"
    },
    "tag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": ["corpus", "performance", "revision", "schema", "security_review", "tag"],
  "title": "workflow-verifier externally reviewed release evidence v1",
  "type": "object"
}
