{
  "$id": "https://workflow-verifier.dev/schema/lock-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
          "provider": { "enum": ["github", "gitlab", "azure", "circleci"] },
          "reference": { "minLength": 1, "type": "string" },
          "revision": { "minLength": 1, "type": "string" },
          "source": { "minLength": 1, "type": "string" }
        },
        "required": ["provider", "reference", "revision", "digest", "source"],
        "type": "object"
      },
      "type": "array"
    },
    "integrity": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "schema": { "const": "lock-v1" }
  },
  "required": ["schema", "integrity", "entries"],
  "title": "workflow-verifier dependency lock v1",
  "type": "object"
}
