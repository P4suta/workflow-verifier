{
  "$id": "https://workflow-verifier.dev/schema/performance-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": { "additionalProperties": { "minLength": 1, "type": "string" }, "minProperties": 1, "type": "object" },
    "regression_explanations": { "items": { "additionalProperties": false, "properties": { "reason": { "minLength": 20, "type": "string" }, "review": { "pattern": "^https://", "type": "string" }, "scenario": { "type": "string" } }, "required": ["reason", "review", "scenario"], "type": "object" }, "type": "array" },
    "revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "scenarios": { "items": { "additionalProperties": false, "properties": { "id": { "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string" }, "samples_ns": { "items": { "minimum": 1, "type": "integer" }, "minItems": 1, "type": "array" } }, "required": ["id", "samples_ns"], "type": "object" }, "minItems": 1, "type": "array" },
    "schema": { "const": "performance-v2" }
  },
  "required": ["environment", "regression_explanations", "revision", "scenarios", "schema"],
  "title": "workflow-verifier performance ledger v2",
  "type": "object"
}
