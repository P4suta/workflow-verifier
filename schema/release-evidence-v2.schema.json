{
  "$id": "https://workflow-verifier.dev/schema/release-evidence-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)|\\\\|^[A-Za-z]:" },
      "type": "string"
    },
    "fileEvidence": {
      "additionalProperties": false,
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "path": { "$ref": "#/$defs/path" }
      },
      "required": ["digest", "path"],
      "type": "object"
    },
    "review": {
      "format": "uri",
      "pattern": "^https://github\\.com/P4suta/workflow-verifier/(?:issues|pull)/[1-9][0-9]*(?:#.*)?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus": { "$ref": "#/$defs/fileEvidence" },
    "maintainer": { "const": "P4suta" },
    "official_compat": { "$ref": "#/$defs/fileEvidence" },
    "performance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": { "$ref": "#/$defs/digest" },
          "path": { "$ref": "#/$defs/path" },
          "platform": {
            "enum": ["linux-x86_64", "windows-x86_64", "macos-arm64", "macos-x86_64"]
          }
        },
        "required": ["digest", "path", "platform"],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "planned_tag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "review": { "$ref": "#/$defs/review" },
    "schema": { "const": "release-evidence-v2" },
    "security_attestation": {
      "additionalProperties": false,
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "path": { "$ref": "#/$defs/path" },
        "signature_digest": { "$ref": "#/$defs/digest" },
        "signature_path": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            { "pattern": "\\.sig$" }
          ]
        }
      },
      "required": ["digest", "path", "signature_digest", "signature_path"],
      "type": "object"
    },
    "subject_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
  },
  "required": [
    "corpus",
    "maintainer",
    "official_compat",
    "performance",
    "planned_tag",
    "review",
    "schema",
    "security_attestation",
    "subject_commit"
  ],
  "title": "workflow-verifier two-commit release evidence v2",
  "type": "object"
}
