{
  "environment": {
    "compiler": "ocaml-5.5",
    "executor": "github-hosted",
    "suite": "four-provider-v1"
  },
  "scenarios": [
    {
      "cwd": "test",
      "id": "four-provider-analysis",
      "modes": {
        "cold": {
          "before_each": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "toggle"]
          ],
          "command": ["../_build/default/bin/main.exe", "check", "--no-cache", "--persona", "audit", "--format", "json", "../_build/performance-workload"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset"]
          ],
          "timeout_seconds": 60
        },
        "incremental": {
          "before_each": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "toggle"]
          ],
          "command": ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-incremental-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-workload"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset"],
            ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-incremental-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-workload"]
          ],
          "timeout_seconds": 60
        },
        "warm": {
          "before_each": [],
          "command": ["../_build/default/bin/main.exe", "check", "--cache", "../_build/performance-warm-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-workload"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset"],
            ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-warm-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-workload"]
          ],
          "timeout_seconds": 60
        }
      }
    },
    {
      "cwd": "test",
      "id": "arcade-scale-analysis",
      "modes": {
        "cold": {
          "before_each": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "toggle", "--scenario", "arcade-scale"]
          ],
          "command": ["../_build/default/bin/main.exe", "check", "--no-cache", "--persona", "audit", "--format", "json", "../_build/performance-arcade-scale"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset", "--scenario", "arcade-scale"]
          ],
          "timeout_seconds": 60
        },
        "incremental": {
          "before_each": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "toggle", "--scenario", "arcade-scale"]
          ],
          "command": ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-arcade-incremental-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-arcade-scale"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset", "--scenario", "arcade-scale"],
            ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-arcade-incremental-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-arcade-scale"]
          ],
          "timeout_seconds": 60
        },
        "warm": {
          "before_each": [],
          "command": ["../_build/default/bin/main.exe", "check", "--cache", "../_build/performance-arcade-warm-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-arcade-scale"],
          "setup": [
            ["python", "-B", "../scripts/benchmark_fixture.py", "--workspace", "..", "--mode", "reset", "--scenario", "arcade-scale"],
            ["../_build/default/bin/main.exe", "check", "--write-cache", "--cache", "../_build/performance-arcade-warm-cache.json", "--persona", "audit", "--format", "json", "../_build/performance-arcade-scale"]
          ],
          "timeout_seconds": 60
        }
      }
    }
  ],
  "schema": "performance-suite-v1"
}
